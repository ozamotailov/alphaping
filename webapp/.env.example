# Базовый URL бэкенд-API (см. ../.env PORT / PUBLIC_API_URL)
VITE_API_URL=http://localhost:3000

# URL манифеста TON Connect. Пусто => берётся <origin фронтенда>/tonconnect-manifest.json
VITE_TONCONNECT_MANIFEST=

# Telegram Mini Apps Analytics (провайдер DataChief) — нужно для листинга в tApps Center.
# Получить в @DataChief_bot: ввести URL бота + домен Mini App → выдаст token и app name.
# Пусто => аналитика выключена (no-op).
VITE_ANALYTICS_TOKEN=
VITE_ANALYTICS_APP=
