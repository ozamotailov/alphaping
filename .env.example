# --- Telegram ---
# Токен бота из @BotFather
BOT_TOKEN=123456:ABC-DEF...
# HTTPS-URL вашего Mini App (фронтенд). Должен быть задан в @BotFather как Web App URL.
WEBAPP_URL=https://app.alphaping.xyz

# --- Хранилище ---
DATABASE_URL=postgres://alphaping:alphaping@localhost:5432/alphaping
REDIS_URL=redis://localhost:6379

# --- Данные TON ---
# Ключ tonapi.io (можно пустым на старте — будет работать с лимитами анонимного доступа)
TONAPI_KEY=

# --- API ---
PORT=3000
# Публичный HTTPS-адрес этого API (для фронтенда). На локали можно прокинуть через туннель.
PUBLIC_API_URL=https://api.alphaping.xyz

# Telegram user id администратора (для /refund и сервисных команд)
ADMIN_ID=0
