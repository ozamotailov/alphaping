# --- Telegram ---
# Токен бота из @BotFather
BOT_TOKEN=123456:ABC-DEF...
# HTTPS-URL вашего Mini App (фронтенд). Должен быть задан в @BotFather как Web App URL.
WEBAPP_URL=https://app.alphaping.xyz

# --- Хранилище ---
DATABASE_URL=postgres://alphaping:alphaping@localhost:5432/alphaping
REDIS_URL=redis://localhost:6379

# --- Данные TON ---
# Ключ tonapi.io (можно пустым на старте — будет работать с лимитами анонимного доступа)
TONAPI_KEY=

# --- API ---
PORT=3000
# Публичный HTTPS-адрес этого API (для фронтенда). На локали можно прокинуть через туннель.
PUBLIC_API_URL=https://api.alphaping.xyz

# Telegram user id администратора (для /refund и сервисных команд)
ADMIN_ID=0

# Публичный канал (полный URL). Если задан — в /start появится кнопка «📣 Channel».
CHANNEL_URL=https://t.me/tonsonar
# Куда бот постит тизер-алерты (@username или числовой id). Бот должен быть АДМИНОМ канала
# с правом постинга. Пусто = авто-постинг выключен.
CHANNEL_CHAT_ID=@tonsonar
# Не постить smart-money покупки меньше этого размера (TON)
CHANNEL_MIN_TON=50

# --- Листинги ---
# Минимальная ликвидность пула ($) для алерта о новом листинге (фильтр мусора)
MIN_LIQUIDITY_USD=1000
# Анти-флуд: если за цикл больше N ВПЕРВЫЕ увиденных пулов — считаем аномалией и не шлём алерты
MAX_NEW_PER_CYCLE=30
# Окно (часы), в течение которого новый пул переоценивается и может «дорасти» до алерта
LISTING_WINDOW_HOURS=48

# --- Алерты ---
# Не слать TON-переводы меньше этого размера (TON) — режет спам «0 TON» при follow smart-money
MIN_TON_TRANSFER=1
